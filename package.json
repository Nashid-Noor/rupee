{
  "name": "rupee",
  "version": "1.0.0",
  "scripts": {
    "dev": "npm run build && wrangler dev",
    "dev:web": "vite",
    "build": "vite build",
    "icons": "pwa-assets-generator",
    "typecheck": "tsc -p tsconfig.worker.json && tsc -p tsconfig.web.json",
    "db:migrate:local": "wrangler d1 migrations apply rupee --local",
    "db:migrate:remote": "wrangler d1 migrations apply rupee --remote",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "^1.2.4",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "hono": "^4.13.17",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261107.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vite-pwa/assets-generator": "^2.0.0",
    "@vitejs/plugin-react": "^6.2.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vite-plugin-pwa": "^2.0.0",
    "wrangler": "^4.158.0"
  },
  "private": true,
  "type": "module"
}
